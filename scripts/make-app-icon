#!/usr/bin/env swift
// Regenerates the app icon PNGs in App/Cathemeral/Assets.xcassets/AppIcon.appiconset from
// App/AppIcon.svg. Run from the repo root: scripts/make-app-icon
//
// The artwork fills 824 of 1024 pixels, centred on a transparent canvas: Apple's macOS icon grid.
import AppKit

let svgPath = "App/AppIcon.svg"
let outDir = "App/Cathemeral/Assets.xcassets/AppIcon.appiconset"
guard let svg = NSImage(contentsOf: URL(fileURLWithPath: svgPath)) else {
    fatalError("Can't read \(svgPath). Run from the repo root.")
}
for px in [16, 32, 64, 128, 256, 512, 1024] {
    let rep = NSBitmapImageRep(
        bitmapDataPlanes: nil, pixelsWide: px, pixelsHigh: px, bitsPerSample: 8, samplesPerPixel: 4,
        hasAlpha: true, isPlanar: false, colorSpaceName: .deviceRGB, bytesPerRow: 0, bitsPerPixel: 0)!
    NSGraphicsContext.saveGraphicsState()
    NSGraphicsContext.current = NSGraphicsContext(bitmapImageRep: rep)
    NSGraphicsContext.current?.imageInterpolation = .high
    let size = CGFloat(px)
    let body = size * 824 / 1024
    let inset = (size - body) / 2
    svg.draw(in: NSRect(x: inset, y: inset, width: body, height: body))
    NSGraphicsContext.restoreGraphicsState()
    try! rep.representation(using: .png, properties: [:])!
        .write(to: URL(fileURLWithPath: "\(outDir)/icon_\(px).png"))
}
